# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Configuration
# Local: mongodb://127.0.0.1:27017/blockchain_voting
# Cloud (MongoDB Atlas): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/blockchain_voting?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/blockchain_voting?retryWrites=true&w=majority

# JWT & Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_production
JWT_EXPIRES_IN=7d

# Blockchain Configuration (Local or Public Testnet)
# Local: http://127.0.0.1:8545
# Polygon Amoy: https://rpc-amoy.polygon.technology
# Ethereum Sepolia: https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer / Relayer Private Key (Exported from MetaMask or generated for the relayer)
# Needs a tiny amount of free testnet tokens from faucet for gas
DEPLOYER_PRIVATE_KEY=your_private_key_without_or_with_0x_prefix

# Deployed Smart Contract Addresses on Testnet
ELECTION_MANAGER_ADDRESS=0x...
PROOF_VERIFIER_ADDRESS=0x...
VOTING_CONTRACT_ADDRESS=0x...
TALLY_REGISTRY_ADDRESS=0x...

